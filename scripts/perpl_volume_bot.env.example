# Copy to scripts/.env and fill in.
# NEVER commit the real .env file. (.env is already in .gitignore.)

# REQUIRED: private key of the wallet you want to trade.
# Accepts WITH or WITHOUT 0x prefix. Both work:
#   PRIVATE_KEY=0xabc123...
#   PRIVATE_KEY=abc123...
PRIVATE_KEY=

# Margin per trade in USD.
#   A number  -> use exactly that much margin per cycle (e.g. 10)
#   "ALL"     -> use full available Perpl balance (with 2% buffer for fees/slippage)
MARGIN_USD=ALL

# Leverage. Max per market: BTC=10, ETH=10, MON=5, SOL=20.
LEVERAGE=10

# Market: 1=BTC, 10=MON, 20=ETH, 30=SOL
MARKET_ID=1

# Trade direction: "long" or "short"
SIDE=long

# How many open+close cycles before the bot stops.
# START AT 1 to verify the bot works on your account.
MAX_ROUND_TRIPS=1

# Hard stop: if (PnL - fees) goes this far below zero, stop.
MAX_DAILY_LOSS_USD=5

# Pause between cycles (seconds).
DELAY_BETWEEN_RT_SEC=5

# Pause between OPEN fill and CLOSE order (seconds). 0 = close immediately.
DELAY_BETWEEN_LEGS_SEC=0
