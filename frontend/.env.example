# Frontend env (Vite). These are UX-only flags — the BACKEND is the source of truth
# for whether a live copy order is actually authorized (COPY_LIVE_ENABLED +
# COPY_LIVE_ALLOWED_WALLETS on the backend). Keep these in sync with the backend.

# Show live copy CTAs as enabled (true) or disabled/observe-only (false).
VITE_COPY_LIVE_ENABLED=false
# Primary copy mode shown in the UI: live_manual | paper (live_auto not supported).
VITE_COPY_MODE=live_manual

# Optional API/WS base overrides (default: same-origin)
# VITE_API_URL=
# VITE_WS_URL=
