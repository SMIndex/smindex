DATABASE_URL=mysql+aiomysql://root:@localhost:3306/perpl
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_HOURS=24
PERPL_REST_URL=https://testnet.perpl.xyz
PERPL_WS_URL=wss://testnet.perpl.xyz/ws/v1
CORS_ORIGINS=http://localhost:5173
WHALE_THRESHOLD_USD=50000
HEATMAP_INTERVAL_SECONDS=10
LOG_LEVEL=INFO

# --- Copy Trading (backend is the source of truth; frontend VITE_* flags are UX only) ---
# Gate for placing REAL live copy orders. Keep false until you intend live trading.
COPY_LIVE_ENABLED=false
# Primary copy mode: live_manual (user confirms each copy) | paper (sandbox). live_auto is refused.
COPY_MODE=live_manual
# Normal per-wallet eligibility = Perpl trading approval (on-chain Perpl account).
# Any Perpl-approved trader may live-copy when COPY_LIVE_ENABLED=true. No internal
# wallet allowlist is required for normal product mode.
#
# OPTIONAL private beta: set COPY_REQUIRE_INTERNAL_ALLOWLIST=true to ALSO require the
# wallet to be in COPY_LIVE_ALLOWED_WALLETS (comma-separated, lowercased). Default false.
COPY_REQUIRE_INTERNAL_ALLOWLIST=false
COPY_LIVE_ALLOWED_WALLETS=
# LIVE COPY EXECUTION allowlist (staged rollout 2026-08-14). FAIL-CLOSED: only
# wallets listed here (comma-separated, lowercased) may place REAL copy orders
# through the gate ladder; EMPTY = NOBODY. AND-ed with COPY_LIVE_ENABLED — the
# global kill switch still disables everything instantly. Prod: admin wallet only;
# full-user enablement is a later owner decision (env change, no deploy).
LIVE_COPY_ALLOWLIST=
# Admin wallets allowed to hide/unhide trader profiles (comma-separated, lowercase)
ADMIN_ADDRESSES=

# Public site URL used for Telegram deep links, MCP deep links and OG card
# urls. Defaults to https://smindex.xyz.
PERPL_TERMINAL_URL=

# Telegram bot token (bot inert when empty)
TELEGRAM_BOT_TOKEN=
